# Copy to .env.local for local development. Never commit .env.local.
#
# The app runs with zero configuration: every value below has a development
# default. The one that matters in production is SESSION_SECRET, and the app
# refuses to start without a real one (see assertProductionSecret()).

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------

# Signs the session JWT. Minimum 32 characters, random.
# Generate one:  openssl rand -base64 48
#
# In production, a missing secret — or the development fallback — is a startup
# failure, not a warning. A predictable secret means anyone can mint a session
# for any user, including an admin.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Defaults are the shipped, secure values. They are configurable because the
# Playwright suite drives dozens of logins from a single IP and would otherwise
# trip the limit — see docs/DECISIONS.md §7. Raising them in production
# weakens credential-stuffing protection.
RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_CHECKOUT_MAX=10
RATE_LIMIT_CHECKOUT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Public (exposed to the browser — never put a secret in a NEXT_PUBLIC_ var)
# ---------------------------------------------------------------------------

# Absolute site URL, used as metadataBase for Open Graph image resolution.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sent as x-app-version on every API call, for correlating client reports.
NEXT_PUBLIC_APP_VERSION=0.1.0
